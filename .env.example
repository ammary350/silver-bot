# ── Login ──
# Default first-time login uses a QR code shown in the terminal:
#   WhatsApp > Linked Devices > Link a Device
# If a valid session exists, the bot reconnects silently (no QR).
# If the session is invalid/logged out, it is cleared and a fresh QR is shown.

# Pairing-code login is DISABLED by default. To opt in explicitly,
# set PAIRING_NUMBER (headless VPS, no prompts).
# Number must be digits only, with country code (no +, spaces, dashes, parens).
# Example: PAIRING_NUMBER=212722838422
# PAIRING_NUMBER=

# ── Session ──
# By default the bot auto-restores the saved session on restart (no prompts).
# Set FORCE_MENU=1 to show the interactive startup menu (manual choice).
# FORCE_MENU=1

# Optional: pre-configured session string (Heroku/one-click deploy)
# Format: KnightBot!<base64_gzip_creds>
# SESSION_ID=

# ── Node ──
NODE_ENV=production